  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": { "prisma": "6.19.3" }
}
